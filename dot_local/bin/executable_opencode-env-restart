#!/usr/bin/env python3
import datetime
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile
import uuid

STATE = pathlib.Path.home() / ".local/state/opencode/service-restarts"
WRAPPER = pathlib.Path.home() / ".local/bin/opencode-env"
RUN_ID = re.compile(r"^[0-9a-f]{32}$")


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def write(path, value):
    fd, temporary = tempfile.mkstemp(prefix=".receipt-", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as output:
            json.dump(value, output, sort_keys=True)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def start():
    if not WRAPPER.is_file() or not os.access(WRAPPER, os.X_OK):
        print("opencode-env-restart: managed wrapper is unavailable", file=sys.stderr)
        return 1
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    run_id = uuid.uuid4().hex
    run = STATE / run_id
    run.mkdir(mode=0o700)
    launch = run / "launch.json"
    write(launch, {"run_id": run_id, "status": "launching", "created_at": now()})
    try:
        process = subprocess.Popen(
            [sys.executable, str(pathlib.Path(__file__).resolve()), "_run", run_id],
            cwd=pathlib.Path.home(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
        )
    except OSError as error:
        write(run / "result.json", {
            "run_id": run_id, "status": "failed", "finished_at": now(),
            "exit_code": None, "error": type(error).__name__,
        })
        print(json.dumps({"run_id": run_id, "status": "failed", "error": type(error).__name__}))
        return 1
    write(launch, {
        "run_id": run_id, "status": "started", "created_at": now(),
        "pid": process.pid,
    })
    print(json.dumps({"run_id": run_id, "status": "started", "pid": process.pid,
                      "receipt": str(run / "result.json")}))
    return 0


def run_worker(run_id):
    if not RUN_ID.fullmatch(run_id):
        return 2
    run = STATE / run_id
    result = {
        "run_id": run_id, "started_at": now(), "pid": os.getpid(),
        "sid": os.getsid(0), "pgid": os.getpgrp(),
    }
    try:
        process = subprocess.run(
            [str(WRAPPER), "service", "restart"],
            cwd=pathlib.Path.home(),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            check=False,
        )
        result.update({
            "status": "succeeded" if process.returncode == 0 else "failed",
            "exit_code": process.returncode,
        })
    except OSError as error:
        result.update({"status": "failed", "exit_code": None,
                       "error": type(error).__name__})
    result["finished_at"] = now()
    write(run / "result.json", result)
    return 0


def status(run_id=None):
    if not STATE.is_dir():
        print(json.dumps({"status": "unverified", "reason": "no restart receipts"}))
        return 0
    if run_id is None:
        runs = [p for p in STATE.iterdir() if p.is_dir()]
        if not runs:
            print(json.dumps({"status": "unverified", "reason": "no restart receipts"}))
            return 0
        run_id = max(runs, key=lambda p: (p / "launch.json").stat().st_mtime_ns
                      if (p / "launch.json").exists() else p.stat().st_mtime_ns).name
    if not RUN_ID.fullmatch(run_id):
        print("opencode-env-restart: invalid run ID", file=sys.stderr)
        return 2
    run = STATE / run_id
    result = run / "result.json"
    if result.is_file():
        print(result.read_text().strip())
        return 0
    launch = run / "launch.json"
    if not launch.is_file():
        print(json.dumps({"run_id": run_id, "status": "unverified",
                          "reason": "no launch or completion receipt"}))
        return 0
    record = json.loads(launch.read_text())
    pid = record.get("pid")
    alive = False
    if isinstance(pid, int):
        try:
            os.kill(pid, 0)
            alive = True
        except ProcessLookupError:
            pass
        except PermissionError:
            alive = True
    print(json.dumps({"run_id": run_id,
                      "status": "running" if alive else "unverified",
                      "pid": pid,
                      "reason": None if alive else "completion receipt missing"}))
    return 0


def main(argv):
    if argv == ["start"]:
        return start()
    if len(argv) == 2 and argv[0] == "_run":
        return run_worker(argv[1])
    if argv == ["status"]:
        return status()
    if len(argv) == 2 and argv[0] == "status":
        return status(argv[1])
    print("usage: opencode-env-restart start | status [run-id]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

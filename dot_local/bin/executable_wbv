#!/bin/sh
set -eu

store=$HOME/.local/share/beads/work/.beads
work_config=$HOME/.config/bv/work-beads.yaml

die() {
  printf 'wbv: %s\n' "$*" >&2
  exit 1
}

[ -d "$store" ] || die "store is missing; run 'wbd bootstrap'"
command -v bd >/dev/null 2>&1 || die 'required command not found: bd'
command -v bv >/dev/null 2>&1 || die 'required command not found: bv'
command -v wbd >/dev/null 2>&1 || die 'required command not found: wbd'

for arg in "$@"; do
  case "$arg" in
    --db|--db=*|-db|-db=*|--work-config|--work-config=*|--history-mode|--history-mode=*|--workspace|--workspace=*|--as-of|--as-of=*)
      die 'Viewer data source and history mode override flags are disabled'
      ;;
    --agents-add|--agents-add=*|--agents-remove|--agents-remove=*|--agents-update|--agents-update=*)
      die 'Viewer repository agent-file mutation flags are disabled'
      ;;
  esac
done

wbd configure >/dev/null
exec env \
  -u BD_DB \
  -u BEADS_DB \
  -u BD_GLOBAL \
  -u BEADS_DOLT_DATA_DIR \
  -u BEADS_DOLT_PROXIED_SERVER \
  -u BEADS_DOLT_SERVER_MODE \
  -u BEADS_DOLT_SHARED_SERVER \
  BEADS_DIR="$store" \
  BV_NO_GITIGNORE=1 \
  BV_NO_CACHE=1 \
  bv --history-mode external --work-config "$work_config" "$@"

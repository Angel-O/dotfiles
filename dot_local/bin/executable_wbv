#!/bin/bash
set -euo pipefail

store=$HOME/.local/share/beads/hub/.beads
hub_config=$HOME/.config/bv/hub.yaml

die() {
  printf 'wbv: %s\n' "$*" >&2
  exit 1
}

mode=auto
if [ "${1:-}" = --local ] || [ "${1:-}" = --hub ]; then
  mode=${1#--}
  shift
fi
for arg in "$@"; do
  case "$arg" in
    --local|--hub) die "mode selector must be the first argument: $arg" ;;
    --local=*|--hub=*) die "mode selector does not take a value: ${arg%%=*}" ;;
  esac
done

git_root=
if git_root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -n "$git_root" ]; then
  local_marker=$git_root/.beads
else
  git_root=
  local_marker=
fi

if [ "$mode" = auto ]; then
  mode=hub
  if [ -n "$local_marker" ] && { [ -e "$local_marker" ] || [ -L "$local_marker" ]; }; then
    mode=local
  fi
fi

if [ "$mode" = local ]; then
  [ -n "$git_root" ] || die 'local mode requires a Git worktree'
  { [ -e "$local_marker" ] || [ -L "$local_marker" ]; } ||
    die "local Beads store is missing at $local_marker"
  [ ! -L "$local_marker" ] || die "local Beads marker must not be a symlink: $local_marker"
  [ -d "$local_marker" ] || die "unsupported local Beads marker at $local_marker"
  command -v bv >/dev/null 2>&1 || die 'required command not found: bv'
else
  [ -d "$store" ] || die "store is missing; run 'wbd bootstrap'"
  command -v bd >/dev/null 2>&1 || die 'required command not found: bd'
  command -v bv >/dev/null 2>&1 || die 'required command not found: bv'
  command -v wbd >/dev/null 2>&1 || die 'required command not found: wbd'
fi

safe_value() {
  [ -n "$2" ] || die "missing value for $1"
  case "$2" in
    -*) die "invalid value for $1: $2" ;;
    *$'\n'*|*$'\r'*|*$'\t'*) die "invalid control character in $1" ;;
  esac
}

validate_uint() {
  local flag=$1 value=$2 minimum=$3 maximum=$4
  [[ $value =~ ^[0-9]+$ ]] && [ "${#value}" -le 9 ] ||
    die "invalid integer for $flag: $value"
  ((10#$value >= minimum && 10#$value <= maximum)) ||
    die "value for $flag must be between $minimum and $maximum"
}

mark_seen() {
  case " $seen " in
    *" $1 "*) die "duplicate Viewer option: $1" ;;
  esac
  seen="$seen $1"
}

if [ "$#" -eq 0 ]; then
  [ -t 0 ] && [ -t 1 ] || die 'bare wbv requires an interactive terminal'
  viewer_args=()
  robot=false
else
  primary=$1
  shift
  robot=true
  needs_brief=false
  case "$primary" in
    --robot-plan|--robot-priority|--robot-insights|--robot-graph|--robot-label-health|--robot-label-flow|--robot-label-attention|--robot-sprint-list|--robot-capacity)
      viewer_args=("$primary")
      ;;
    --robot-blocker-chain|--robot-sprint-show|--robot-forecast)
      [ "$#" -gt 0 ] || die "missing value for $primary"
      safe_value "$primary" "$1"
      if [ "$primary" = --robot-forecast ]; then
        [ "$1" = all ] || [[ $1 != -* ]] || die "invalid value for $primary: $1"
      fi
      viewer_args=("$primary" "$1")
      shift
      ;;
    --robot-triage)
      viewer_args=("$primary")
      needs_brief=true
      ;;
    *)
      die "unsupported Viewer invocation: $primary"
      ;;
  esac

  seen=
  while [ "$#" -gt 0 ]; do
    flag=$1
    shift
    case "$flag" in
      --brief)
        [ "$primary" = --robot-triage ] || die "$flag is not supported with $primary"
        mark_seen "$flag"
        viewer_args+=("$flag")
        needs_brief=false
        ;;
      --label)
        case "$primary" in
          --robot-plan|--robot-priority|--robot-insights) ;;
          *) die "$flag is not supported with $primary" ;;
        esac
        [ "$#" -gt 0 ] || die "missing value for $flag"
        safe_value "$flag" "$1"
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --robot-min-confidence)
        [ "$primary" = --robot-priority ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        [[ $1 =~ ^(0([.][0-9]+)?|1([.]0+)?)$ ]] || die "invalid confidence for $flag: $1"
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --robot-max-results)
        [ "$primary" = --robot-priority ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        validate_uint "$flag" "$1" 1 1000
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --robot-by-label|--robot-by-assignee)
        [ "$primary" = --robot-priority ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        safe_value "$flag" "$1"
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --graph-format)
        [ "$primary" = --robot-graph ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        case "$1" in json|dot|mermaid) ;; *) die "invalid graph format: $1" ;; esac
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --graph-root)
        [ "$primary" = --robot-graph ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        safe_value "$flag" "$1"
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --graph-depth)
        [ "$primary" = --robot-graph ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        validate_uint "$flag" "$1" 0 100
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --attention-limit)
        [ "$primary" = --robot-label-attention ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        validate_uint "$flag" "$1" 1 1000
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --forecast-label|--forecast-sprint)
        [ "$primary" = --robot-forecast ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        safe_value "$flag" "$1"
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --forecast-agents)
        [ "$primary" = --robot-forecast ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        validate_uint "$flag" "$1" 1 64
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --agents)
        [ "$primary" = --robot-capacity ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        validate_uint "$flag" "$1" 1 64
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --capacity-label)
        [ "$primary" = --robot-capacity ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        safe_value "$flag" "$1"
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      --robot-not-ready-labels)
        [ "$primary" = --robot-triage ] || die "$flag is not supported with $primary"
        [ "$#" -gt 0 ] || die "missing value for $flag"
        safe_value "$flag" "$1"
        mark_seen "$flag"
        viewer_args+=("$flag" "$1")
        shift
        ;;
      *)
        die "unsupported Viewer option for $primary: $flag"
        ;;
    esac
  done
  $needs_brief && die '--robot-triage requires --brief'
fi

viewer_env=(
  -u BEADS_DIR \
  -u BD_DB \
  -u BEADS_DB \
  -u BD_GLOBAL \
  -u BEADS_DOLT_DATA_DIR \
  -u BEADS_DOLT_PORT \
  -u BEADS_DOLT_PROXIED_SERVER \
  -u BEADS_DOLT_SERVER_DATABASE \
  -u BEADS_DOLT_SERVER_HOST \
  -u BEADS_DOLT_SERVER_MODE \
  -u BEADS_DOLT_SERVER_PORT \
  -u BEADS_DOLT_SERVER_SOCKET \
  -u BEADS_DOLT_SHARED_SERVER \
  -u BV_OUTPUT_FORMAT \
  -u TOON_DEFAULT_FORMAT \
  -u TOON_STATS \
  -u BV_PRETTY_JSON \
  -u BV_ROBOT \
  -u BV_ROBOT_NOT_READY_LABELS \
  -u BV_ROBOT_HISTORY_TIMEOUT_MS \
  -u BV_INSIGHTS_MAP_LIMIT \
  BV_NO_GITIGNORE=1 \
  BV_NO_CACHE=1
)

if [ "$mode" = local ]; then
  cd "$git_root"
  viewer_command=(bv --history-mode git)
else
  wbd configure >/dev/null
  viewer_env+=(BEADS_DIR="$store")
  viewer_command=(bv --history-mode external --hub-config "$hub_config")
fi

if $robot; then
  viewer_command+=("${viewer_args[@]}" --format json)
fi
exec env "${viewer_env[@]}" "${viewer_command[@]}"

#!/usr/bin/env bash
set -Eeuo pipefail

# One deliberately small adapter owns the allowed primary-agent layouts.
usage() {
  printf 'usage: %s architect sibling NAME [--tracking-bead BEAD_ID]\n       %s worker tab NAME [ABSOLUTE_PATH] [--tracking-bead BEAD_ID]\n       %s worker worktree NAME ABSOLUTE_PATH [--tracking-bead BEAD_ID]\n' "$0" "$0" "$0" >&2
  exit 2
}

fail() {
  printf 'herdr-agent-launch: %s\n' "$*" >&2
  exit 1
}

tracking_bead=
positional=()
while [[ $# -gt 0 && $1 != --* ]]; do
  positional+=("$1")
  shift
done
if [[ $# -gt 0 ]]; then
  [[ "$1" == --tracking-bead && $# -eq 2 && -n "$2" && "$2" != --* ]] || usage
  tracking_bead=$2
fi
set -- "${positional[@]}"
[[ $# -ge 2 ]] || usage
role=$1
topology=$2
case "$role/$topology" in
  architect/sibling) [[ $# -eq 3 ]] || usage ;;
  worker/tab) [[ $# -eq 3 || $# -eq 4 ]] || usage ;;
  worker/worktree) [[ $# -eq 4 ]] || usage ;;
  *) usage ;;
esac

agent_name=$3
[[ "$agent_name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || fail "invalid agent name: $agent_name"
if [[ -n "$tracking_bead" ]]; then
  [[ "$tracking_bead" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$tracking_bead" != *..* ]] ||
    fail 'invalid tracking bead'
fi

worktree_path=
worker_cwd=
source_repo=
if [[ "$role/$topology" == worker/worktree ]]; then
  worktree_path=$4
  [[ "$worktree_path" == /* ]] || fail 'worktree path must be absolute'
elif [[ "$role/$topology" == worker/tab && $# -eq 4 ]]; then
  worktree_path=$4
  [[ "$worktree_path" == /* ]] || fail 'worktree path must be absolute'
  [[ -d "$worktree_path" ]] || fail 'worktree path must be an existing directory'
  worker_cwd=$worktree_path
fi

[[ "${HERDR_ENV:-}" == 1 ]] || fail 'must run inside a Herdr-managed pane'
[[ -n "${HERDR_WORKSPACE_ID:-}" && -n "${HERDR_TAB_ID:-}" && -n "${HERDR_PANE_ID:-}" ]] ||
  fail 'Herdr caller context is incomplete'
command -v herdr >/dev/null 2>&1 || fail 'herdr is not installed'
command -v jq >/dev/null 2>&1 || fail 'jq is not installed'
command -v opencode >/dev/null 2>&1 || fail 'opencode is not installed'
opencode_launcher="$HOME/.local/bin/opencode-env"
[[ -x "$opencode_launcher" ]] || fail 'managed OpenCode launcher is not installed'
if [[ "$role/$topology" == worker/worktree ]]; then
  # The launcher process selects the repository; pane cwd is placement metadata.
  if ! source_repo=$(git rev-parse --show-toplevel 2>/dev/null); then
    fail 'launcher cwd is not inside a Git repository'
  fi
fi

response=
herdr_call() {
  local expected_type=$1
  local required=$2
  shift 2
  if ! response=$(herdr "$@" 2>&1); then
    if [[ "$1 $2" == "agent start" && "$response" == *'"code":"agent_pane_busy"'* ]]; then
      sleep 0.1
      response=$(herdr "$@" 2>&1) || fail "$* failed: $response"
    else
      fail "$* failed: $response"
    fi
  fi
  printf '%s\n' "$response" | jq -e --arg expected "$expected_type" \
    'type == "object" and (.result | type == "object") and .result.type == $expected and ('"$required"')' \
    >/dev/null || fail "$* returned malformed or unexpected JSON: $response"
}

jq_value() {
  printf '%s\n' "$response" | jq -r "$1"
}

check_pane() {
  local pane_expression=$1 expected_workspace=$2 expected_tab=$3 expected_cwd=$4 expected_focus=$5
  local pane_workspace pane_tab pane_cwd pane_focus
  pane_workspace=$(jq_value "$pane_expression.workspace_id")
  pane_tab=$(jq_value "$pane_expression.tab_id")
  pane_cwd=$(jq_value "$pane_expression.cwd")
  pane_focus=$(jq_value "$pane_expression.focused")
  [[ "$pane_workspace" == "$expected_workspace" && "$pane_tab" == "$expected_tab" &&
    "$pane_cwd" == "$expected_cwd" && "$pane_focus" == "$expected_focus" ]] ||
    fail "pane placement mismatch: $response"
}

check_agent() {
  local expected_workspace=$1 expected_tab=$2 expected_pane=$3 expected_cwd=$4
  jq -e --arg name "$agent_name" --arg workspace "$expected_workspace" \
    --arg tab "$expected_tab" --arg pane "$expected_pane" --arg cwd "$expected_cwd" \
    '.result.agent.name == $name and .result.agent.agent == "opencode" and
     .result.agent.workspace_id == $workspace and .result.agent.tab_id == $tab and
     .result.agent.pane_id == $pane and .result.agent.cwd == $cwd and
     .result.agent.focused == false and .result.agent.interactive_ready == true' <<<"$response" >/dev/null ||
    fail "agent identity or placement mismatch: $response"
}

herdr_call pane_current \
  '.result.pane | type == "object" and (.pane_id | type == "string") and
   (.workspace_id | type == "string") and (.tab_id | type == "string") and
   (.cwd | type == "string") and (.focused | type == "boolean")' \
  pane current --current
caller_pane=$(jq_value '.result.pane.pane_id')
caller_workspace=$(jq_value '.result.pane.workspace_id')
caller_tab=$(jq_value '.result.pane.tab_id')
caller_cwd=$(jq_value '.result.pane.cwd')
[[ "$caller_pane" == "$HERDR_PANE_ID" && "$caller_workspace" == "$HERDR_WORKSPACE_ID" &&
  "$caller_tab" == "$HERDR_TAB_ID" ]] || fail "caller context mismatch: $response"
if [[ "$role/$topology" == worker/tab && -n "$worker_cwd" ]]; then
  [[ "$worker_cwd" != "$caller_cwd" ]] || fail 'worker tab path must differ from caller cwd'
fi

case "$role/$topology" in
  architect/sibling)
    herdr_call pane_info \
      '.result.pane | type == "object" and (.pane_id | type == "string") and
       (.workspace_id | type == "string") and (.tab_id | type == "string") and
       (.cwd | type == "string") and (.focused | type == "boolean")' \
      pane split --current --direction right --cwd "$caller_cwd" --no-focus
    pane_id=$(jq_value '.result.pane.pane_id')
    [[ "$pane_id" != "$caller_pane" ]] || fail 'split returned the caller pane'
    check_pane .result.pane "$caller_workspace" "$caller_tab" "$caller_cwd" false
    herdr_call pane_info 'true' pane rename "$caller_pane" orchestrator
    herdr_call pane_info 'true' pane rename "$pane_id" architect
    workspace_id=$caller_workspace
    tab_id=$caller_tab
    ;;
  worker/tab)
    # Herdr's tab label is the visible tab title; the agent argument only selects the role.
    herdr_call tab_created \
      '.result | (.tab | type == "object") and (.root_pane | type == "object") and
       (.tab.tab_id | type == "string") and (.tab.workspace_id | type == "string") and
       (.tab.label | type == "string") and
       (.tab.focused == false) and (.root_pane.focused == false)' \
      tab create --workspace "$caller_workspace" --cwd "${worker_cwd:-$caller_cwd}" --label "$agent_name" --no-focus
    tab_id=$(jq_value '.result.tab.tab_id')
    workspace_id=$(jq_value '.result.tab.workspace_id')
    pane_id=$(jq_value '.result.root_pane.pane_id')
    [[ "$workspace_id" == "$caller_workspace" && "$tab_id" != "$caller_tab" ]] ||
      fail "tab placement mismatch: $response"
    jq -e --arg name "$agent_name" '.result.tab.label == $name' <<<"$response" >/dev/null ||
      fail "tab label mismatch: $response"
    check_pane .result.root_pane "$caller_workspace" "$tab_id" "${worker_cwd:-$caller_cwd}" false
    ;;
  worker/worktree)
    if [[ -e "$worktree_path" ]]; then
      # Existing worktrees are reopened by path; their branch is not renamed.
      worktree_command=(worktree open --cwd "$source_repo" --path "$worktree_path" --label "$agent_name" --no-focus)
      expected_type=worktree_opened
    else
      # agent_name is already validated and ID-free, so use it directly in the branch.
      worktree_command=(worktree create --cwd "$source_repo" --branch "worktree/$agent_name" --path "$worktree_path" --label "$agent_name" --no-focus)
      expected_type=worktree_created
    fi
    herdr_call "$expected_type" \
      '.result | (.workspace | type == "object") and (.tab | type == "object") and
       (.root_pane | type == "object") and (.worktree | type == "object") and
       (.workspace.workspace_id | type == "string") and (.workspace.focused == false) and
       (.workspace.worktree | type == "object") and
       (.workspace.worktree.repo_root | type == "string") and
       (.workspace.worktree.checkout_path | type == "string") and
       (.workspace.worktree.is_linked_worktree == true) and
       (.worktree.path | type == "string") and (.worktree.is_linked_worktree == true) and
       (.tab.focused == false) and (.root_pane.focused == false)' \
       "${worktree_command[@]}"
    jq -e --arg name "$agent_name" \
      '.result.workspace.label == $name' <<<"$response" >/dev/null ||
      fail "worktree label mismatch: $response"
    [[ "$(jq_value '.result.workspace.worktree.repo_root')" == "$source_repo" ]] ||
      fail "worktree repository mismatch: $response"
    workspace_id=$(jq_value '.result.workspace.workspace_id')
    tab_id=$(jq_value '.result.tab.tab_id')
    pane_id=$(jq_value '.result.root_pane.pane_id')
    [[ "$workspace_id" != "$caller_workspace" &&
      "$(jq_value '.result.workspace.worktree.checkout_path')" == "$worktree_path" &&
      "$(jq_value '.result.worktree.path')" == "$worktree_path" &&
      "$(jq_value '.result.tab.workspace_id')" == "$workspace_id" ]] ||
      fail "worktree placement mismatch: $response"
    check_pane .result.root_pane "$workspace_id" "$tab_id" "$worktree_path" false
    ;;
esac

agent_cwd=$caller_cwd
[[ "$role/$topology" == worker/worktree ]] && agent_cwd=$worktree_path
[[ "$role/$topology" == worker/tab && -n "$worker_cwd" ]] && agent_cwd=$worker_cwd
session_request=$(jq -cn --arg agent "$role" --arg directory "$agent_cwd" \
  '{agent:$agent, location:{directory:$directory}}')
if ! session_response=$("$opencode_launcher" api session.create --data "$session_request" 2>&1); then
  fail "opencode session creation failed: $session_response"
fi
session_id=$(jq -er --arg role "$role" --arg cwd "$agent_cwd" \
  '.data | select(.agent == $role and .location.directory == $cwd) | .id |
   select(type == "string" and startswith("ses") and length > 3)' \
  <<<"$session_response") || fail "opencode session creation returned malformed or unexpected JSON: $session_response"

if [[ -n "$tracking_bead" ]]; then
  metadata_request=$(jq -cn --arg session "$session_id" --arg bead "$tracking_bead" \
    '{metadata:{"orchestration-tracking.launch":{version:1,targetSessionID:$session,beadID:$bead}}}')
  if ! opencode api session.update --param "sessionID=$session_id" --data "$metadata_request" \
    >/dev/null 2>&1; then
    printf 'herdr-agent-launch: tracking metadata update failed; continuing launch.\n' >&2
  fi
fi
# Herdr omits false-valued launch_pending; accept that current form and explicit false only.
herdr_call agent_started \
  '.result | (.agent | type == "object") and (.argv | type == "array") and
   (.agent.name | type == "string") and (.agent.agent | type == "string") and
   (.agent.workspace_id | type == "string") and (.agent.tab_id | type == "string") and
    (.agent.pane_id | type == "string") and (.agent.cwd | type == "string") and
     (.agent.focused | type == "boolean") and
     ((.agent | has("launch_pending") | not) or (.agent.launch_pending == false)) and
     (.agent.interactive_ready == true)' \
  agent start "$agent_name" --kind opencode --pane "$pane_id" -- --session "$session_id"
jq -e --arg name "$agent_name" --arg session "$session_id" \
  '.result.argv == ["opencode", "--session", $session] and
    .result.agent.name == $name and .result.agent.agent == "opencode"' \
  <<<"$response" >/dev/null || fail "agent argv mismatch: $response"
check_agent "$workspace_id" "$tab_id" "$pane_id" "$agent_cwd"

herdr_call agent_info \
  '.result.agent | type == "object" and (.name | type == "string") and
   (.agent | type == "string") and (.workspace_id | type == "string") and
   (.tab_id | type == "string") and (.pane_id | type == "string") and
   (.cwd | type == "string") and (.focused | type == "boolean")' \
  agent get "$agent_name"
check_agent "$workspace_id" "$tab_id" "$pane_id" "$agent_cwd"

open_reviewr() {
  local reviewr_response
  case "$topology" in
    tab)
      # Target the worker pane so Herdr keeps its default split orientation.
      if ! reviewr_response=$(herdr plugin pane open \
        --plugin persiyanov.reviewr \
        --entrypoint pane \
        --placement split \
        --target-pane "$pane_id" \
        --cwd "$agent_cwd" \
        --no-focus 2>&1); then
        printf 'herdr-agent-launch: Reviewr open failed: %s\n' "$reviewr_response" >&2
      fi
      ;;
    worktree)
      if ! reviewr_response=$(herdr plugin pane open \
        --plugin persiyanov.reviewr \
        --entrypoint pane \
        --placement tab \
        --workspace "$workspace_id" \
        --cwd "$agent_cwd" \
        --no-focus 2>&1); then
        printf 'herdr-agent-launch: Reviewr open failed: %s\n' "$reviewr_response" >&2
      else
        # Rename only the tab returned by this open; naming remains best effort.
        reviewr_tab_id=$(printf '%s\n' "$reviewr_response" |
          jq -r '.result.plugin_pane.pane.tab_id // empty' 2>/dev/null) || reviewr_tab_id=
        if [[ -n "$reviewr_tab_id" ]]; then
          herdr tab rename "$reviewr_tab_id" reviewr >/dev/null 2>&1 || true
        fi
      fi
      ;;
  esac
}

if [[ "$role" == worker ]]; then
  open_reviewr
fi

if [[ "$role/$topology" == worker/worktree ]]; then
  jq -cn --arg role "$role" --arg topology "$topology" --arg name "$agent_name" \
    --arg kind opencode --arg workspace "$workspace_id" --arg tab "$tab_id" \
    --arg pane "$pane_id" --arg cwd "$agent_cwd" --arg path "$worktree_path" --arg session "$session_id" \
    '{role:$role, topology:$topology, agent_name:$name, agent_kind:$kind,
      workspace_id:$workspace, tab_id:$tab, pane_id:$pane, cwd:$cwd, session_id:$session,
      worktree_path:$path}'
else
  jq -cn --arg role "$role" --arg topology "$topology" --arg name "$agent_name" \
    --arg kind opencode --arg workspace "$workspace_id" --arg tab "$tab_id" \
    --arg pane "$pane_id" --arg cwd "$agent_cwd" --arg session "$session_id" \
    '{role:$role, topology:$topology, agent_name:$name, agent_kind:$kind,
      workspace_id:$workspace, tab_id:$tab, pane_id:$pane, cwd:$cwd, session_id:$session}'
fi

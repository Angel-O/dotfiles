#!/bin/bash
set -euo pipefail

store=$HOME/.local/share/beads/work/.beads
parent=${store%/.beads}
work_config=$HOME/.config/bv/work-beads.yaml
ledger=$parent/correlations.jsonl

die() {
  printf 'wbd: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

run_bd_bootstrap() {
  env \
    -u BD_DB \
    -u BEADS_DB \
    -u BD_GLOBAL \
    -u BEADS_DOLT_DATA_DIR \
    -u BEADS_DOLT_PROXIED_SERVER \
    -u BEADS_DOLT_SERVER_MODE \
    -u BEADS_DOLT_SHARED_SERVER \
    BEADS_DIR="$store" \
    bd "$@"
}

run_bd() {
  run_bd_bootstrap --db "$store" "$@"
}

run_bv() {
  env \
    -u BD_DB \
    -u BEADS_DB \
    -u BD_GLOBAL \
    -u BEADS_DOLT_DATA_DIR \
    -u BEADS_DOLT_PROXIED_SERVER \
    -u BEADS_DOLT_SERVER_MODE \
    -u BEADS_DOLT_SHARED_SERVER \
    BEADS_DIR="$store" \
    BV_NO_GITIGNORE=1 \
    bv "$@"
}

replace_if_changed() {
  local tmp=$1 target=$2
  chmod 0600 "$tmp"
  if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    chmod 0600 "$target"
  else
    mv "$tmp" "$target"
  fi
}

ensure_work_config() {
  need jq
  [ ! -L "$work_config" ] || die "work config must not be a symlink: $work_config"
  [ ! -e "$work_config" ] || [ -f "$work_config" ] ||
    die "work config must be a regular file: $work_config"
  umask 077
  mkdir -p "${work_config%/*}"

  local tmp
  tmp=$(mktemp "$work_config.tmp.XXXXXX") || die 'cannot create temporary work config'
  if [ -e "$work_config" ]; then
    if ! jq -S \
      --arg store "$store" \
      --arg ledger "$ledger" \
      'if type != "object" then error("work config must be an object")
       elif (keys - ["ledger", "repositories", "store", "version"] | length) != 0 then error("unknown work config field")
       elif .version != 1 then error("unsupported work config version")
       elif ((.repositories // {}) | type) != "object" then error("repositories must be an object")
       elif any((.repositories // {}) | to_entries[];
         (.key | type) != "string" or (.key | startswith("ctx:") | not) or
         (.value | type) != "object" or (.value | keys) != ["path"] or
         (.value.path | type) != "string" or (.value.path | length) == 0)
       then error("invalid repository entry")
       else .store = $store | .ledger = $ledger | .repositories = (.repositories // {})
       end' \
      "$work_config" >"$tmp"; then
      rm -f "$tmp"
      die "cannot update work config: $work_config"
    fi
  else
    jq -nS \
      --arg store "$store" \
      --arg ledger "$ledger" \
      '{version: 1, store: $store, ledger: $ledger, repositories: {}}' >"$tmp"
  fi
  replace_if_changed "$tmp" "$work_config"
}

register_repository() {
  need git
  registered_context=$(context)
  registered_root=$(git rev-parse --show-toplevel 2>/dev/null) ||
    die 'cannot resolve the current Git repository root'
  case "$registered_root" in
    *$'\n'*|*$'\r'*|*$'\t'*) die 'repository path contains an unsupported control character' ;;
  esac
  ensure_work_config

  local tmp
  tmp=$(mktemp "$work_config.tmp.XXXXXX") || die 'cannot create temporary work config'
  if ! jq -S \
    --arg context "$registered_context" \
    --arg path "$registered_root" \
    '.repositories[$context] = {path: $path}' \
    "$work_config" >"$tmp"; then
    rm -f "$tmp"
    die "cannot register repository in work config: $work_config"
  fi
  replace_if_changed "$tmp" "$work_config"
}

context() {
  need git
  local inside
  inside=$(git rev-parse --is-inside-work-tree 2>/dev/null) ||
    die 'current directory is not inside a Git repository'
  [ "$inside" = true ] || die 'current directory is not inside a Git work tree'

  local origin rest host path identity repo_name slug digest
  origin=$(git config --get remote.origin.url 2>/dev/null) ||
    die 'current repository has no origin remote'
  [ -n "$origin" ] || die 'current repository has no origin remote'

  case "$origin" in
    ssh://*|https://*)
      rest=${origin#*://}
      case "$rest" in
        *@*) rest=${rest#*@} ;;
      esac
      host=${rest%%/*}
      [ "$host" != "$rest" ] || die 'origin remote has no repository path'
      path=${rest#*/}
      ;;
    *:*)
      rest=$origin
      case "$rest" in
        *@*) rest=${rest#*@} ;;
      esac
      host=${rest%%:*}
      path=${rest#*:}
      ;;
    *)
      die 'origin remote must use SSH or HTTPS'
      ;;
  esac

  path=${path%%\?*}
  path=${path%%\#*}
  while [ "${path#/}" != "$path" ]; do path=${path#/}; done
  while [ "${path%/}" != "$path" ]; do path=${path%/}; done
  path=${path%.git}
  [ -n "$host" ] && [ -n "$path" ] || die 'origin remote has no repository identity'

  identity=$(printf '%s/%s' "$host" "$path" | tr '[:upper:]' '[:lower:]')
  repo_name=${path##*/}
  slug=$(printf '%s' "$repo_name" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')
  [ -n "$slug" ] || die 'origin remote has no path-safe repository name'

  if command -v shasum >/dev/null 2>&1; then
    digest=$(printf '%s' "$identity" | shasum -a 256 | sed 's/[[:space:]].*$//')
  elif command -v sha256sum >/dev/null 2>&1; then
    digest=$(printf '%s' "$identity" | sha256sum | sed 's/[[:space:]].*$//')
  else
    die 'required SHA-256 command not found'
  fi
  printf 'ctx:%s-%s\n' "$slug" "${digest:0:10}"
}

bootstrap() {
  need bd
  need git
  need jq
  [ ! -e "$store" ] || die "store already exists: $store"
  [ -d "$HOME" ] && [ -w "$HOME" ] || die "HOME is not writable: $HOME"

  umask 077
  mkdir -p "$parent" || die "cannot create store parent: $parent"
  [ -d "$parent" ] && [ -w "$parent" ] || die "store parent is not writable: $parent"
  if git -C "$parent" rev-parse --git-dir >/dev/null 2>&1; then
    die "store parent must be outside every Git repository: $parent"
  fi

  if (
    cd "$parent" &&
      run_bd_bootstrap metrics off &&
      run_bd_bootstrap init \
        --prefix work \
        --non-interactive \
        --skip-hooks \
        --skip-agents &&
       run_bd config set export.auto false &&
       run_bd config set export.git-add false &&
       run_bd config set dolt.auto-push false &&
       ensure_work_config
  ); then
    return 0
  else
    status=$?
  fi

  rm -rf -- "$store"
  return "$status"
}

if [ "${1:-}" = bootstrap ]; then
  [ "$#" -eq 1 ] || die 'usage: wbd bootstrap'
  bootstrap
  exit 0
fi

[ -d "$store" ] || die "store is missing; run 'wbd bootstrap'"
need bd

for arg in "$@"; do
  case "$arg" in
    --db|--db=*|--database|--database=*|--global|--global=*|-C|-C*|--directory|--directory=*)
      die 'database routing and directory override flags are disabled'
      ;;
  esac
done

leading_args=()
command_args=()
command_name=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --actor|--dolt-auto-commit)
      [ "$#" -ge 2 ] || die "missing value for leading global flag: $1"
      leading_args+=("$1" "$2")
      shift 2
      ;;
    --actor=*|--dolt-auto-commit=*|--help|--ignore-schema-skew|--json|--profile|--readonly|--sandbox|--version|-h|-q|-v|-V|--quiet|--verbose)
      leading_args+=("$1")
      shift
      ;;
    -*)
      die 'put the bd command before its flags'
      ;;
    *)
      command_name=$1
      shift
      command_args=("$@")
      break
      ;;
  esac
done

case "$command_name" in
  init)
    die "direct init is disabled; run 'wbd bootstrap'"
    ;;
  bootstrap)
    die 'usage: wbd bootstrap'
    ;;
  context)
    [ "${#leading_args[@]}" -eq 0 ] && [ "${#command_args[@]}" -eq 0 ] ||
      die 'usage: wbd context'
    context
    ;;
  configure)
    [ "${#leading_args[@]}" -eq 0 ] && [ "${#command_args[@]}" -eq 0 ] ||
      die 'usage: wbd configure'
    ensure_work_config
    printf '%s\n' "$work_config"
    ;;
  register)
    [ "${#leading_args[@]}" -eq 0 ] && [ "${#command_args[@]}" -eq 0 ] ||
      die 'usage: wbd register'
    register_repository
    printf '%s\t%s\n' "$registered_context" "$registered_root"
    ;;
  create|new)
    for arg in ${command_args[@]+"${command_args[@]}"}; do
      case "$arg" in
        --repo|--repo=*) die 'create repository routing flags are disabled' ;;
      esac
    done
    register_repository
    context_label=$registered_context
    run_bd ${leading_args[@]+"${leading_args[@]}"} "$command_name" --labels "$context_label" ${command_args[@]+"${command_args[@]}"}
    ;;
  list)
    all_contexts=false
    args=()
    for arg in ${command_args[@]+"${command_args[@]}"}; do
      if [ "$arg" = --all-contexts ]; then
        all_contexts=true
      else
        args+=("$arg")
      fi
    done
    if $all_contexts; then
      run_bd ${leading_args[@]+"${leading_args[@]}"} list ${args[@]+"${args[@]}"}
    else
      register_repository
      context_label=$registered_context
      run_bd ${leading_args[@]+"${leading_args[@]}"} list --label "$context_label" ${args[@]+"${args[@]}"}
    fi
    ;;
  link)
    [ "${#leading_args[@]}" -eq 0 ] || die 'usage: wbd link <bead-id> [commit]'
    [ "${#command_args[@]}" -ge 1 ] && [ "${#command_args[@]}" -le 2 ] ||
      die 'usage: wbd link <bead-id> [commit]'
    need bv
    register_repository
    run_bv correlate add \
      --bead "${command_args[0]}" \
      --repo "$registered_context" \
      --commit "${command_args[1]:-HEAD}" \
      --work-config "$work_config"
    ;;
  show|update|dep|close|reopen)
    run_bd ${leading_args[@]+"${leading_args[@]}"} "$command_name" ${command_args[@]+"${command_args[@]}"}
    ;;
  *)
    die 'supported commands: bootstrap, configure, register, context, create, new, list, show, update, dep, close, reopen, link'
    ;;
esac

#!/bin/bash
set -euo pipefail

store=$HOME/.local/share/beads/hub/.beads
parent=${store%/.beads}
hub_config=$HOME/.config/bv/hub.yaml
ledger=$parent/correlations.jsonl

die() {
  printf 'wbd: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

run_bd_bootstrap() {
  env \
    -u BD_DB \
    -u BEADS_DB \
    -u BD_GLOBAL \
    -u BEADS_DOLT_DATA_DIR \
    -u BEADS_DOLT_PORT \
    -u BEADS_DOLT_PROXIED_SERVER \
    -u BEADS_DOLT_SERVER_DATABASE \
    -u BEADS_DOLT_SERVER_HOST \
    -u BEADS_DOLT_SERVER_MODE \
    -u BEADS_DOLT_SERVER_PORT \
    -u BEADS_DOLT_SERVER_SOCKET \
    -u BEADS_DOLT_SHARED_SERVER \
    BEADS_DIR="$store" \
    bd "$@"
}

run_bd() {
  run_bd_bootstrap --db "$store" "$@"
}

run_bv() {
  env \
    -u BD_DB \
    -u BEADS_DB \
    -u BD_GLOBAL \
    -u BEADS_DOLT_DATA_DIR \
    -u BEADS_DOLT_PORT \
    -u BEADS_DOLT_PROXIED_SERVER \
    -u BEADS_DOLT_SERVER_DATABASE \
    -u BEADS_DOLT_SERVER_HOST \
    -u BEADS_DOLT_SERVER_MODE \
    -u BEADS_DOLT_SERVER_PORT \
    -u BEADS_DOLT_SERVER_SOCKET \
    -u BEADS_DOLT_SHARED_SERVER \
    BEADS_DIR="$store" \
    BV_NO_GITIGNORE=1 \
    bv "$@"
}

replace_if_changed() {
  local tmp=$1 target=$2
  chmod 0600 "$tmp"
  if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    chmod 0600 "$target"
  else
    mv "$tmp" "$target"
  fi
}

ensure_hub_config() {
  need jq
  [ ! -L "$hub_config" ] || die "hub config must not be a symlink: $hub_config"
  [ ! -e "$hub_config" ] || [ -f "$hub_config" ] ||
    die "hub config must be a regular file: $hub_config"
  umask 077
  mkdir -p "${hub_config%/*}"

  local tmp
  tmp=$(mktemp "$hub_config.tmp.XXXXXX") || die 'cannot create temporary hub config'
  if [ -e "$hub_config" ]; then
    if ! jq -S \
      --arg store "$store" \
      --arg ledger "$ledger" \
       'if type != "object" then error("hub config must be an object")
        elif (keys - ["ledger", "repositories", "store", "version"] | length) != 0 then error("unknown hub config field")
        elif .version != 1 then error("unsupported hub config version")
       elif ((.repositories // {}) | type) != "object" then error("repositories must be an object")
       elif any((.repositories // {}) | to_entries[];
         (.key | type) != "string" or (.key | startswith("ctx:") | not) or
         (.value | type) != "object" or (.value | keys) != ["path"] or
         (.value.path | type) != "string" or (.value.path | length) == 0)
       then error("invalid repository entry")
       else .store = $store | .ledger = $ledger | .repositories = (.repositories // {})
       end' \
      "$hub_config" >"$tmp"; then
      rm -f "$tmp"
      die "cannot update hub config: $hub_config"
    fi
  else
    jq -nS \
      --arg store "$store" \
      --arg ledger "$ledger" \
      '{version: 1, store: $store, ledger: $ledger, repositories: {}}' >"$tmp"
  fi
  replace_if_changed "$tmp" "$hub_config"
}

register_repository() {
  need git
  registered_context=$(context)
  registered_root=$(git rev-parse --show-toplevel 2>/dev/null) ||
    die 'cannot resolve the current Git repository root'
  case "$registered_root" in
    *$'\n'*|*$'\r'*|*$'\t'*) die 'repository path contains an unsupported control character' ;;
  esac
  ensure_hub_config

  local tmp
  tmp=$(mktemp "$hub_config.tmp.XXXXXX") || die 'cannot create temporary hub config'
  if ! jq -S \
    --arg context "$registered_context" \
    --arg path "$registered_root" \
    '.repositories[$context] = {path: $path}' \
    "$hub_config" >"$tmp"; then
    rm -f "$tmp"
    die "cannot register repository in hub config: $hub_config"
  fi
  replace_if_changed "$tmp" "$hub_config"
}

context() {
  need git
  local inside
  inside=$(git rev-parse --is-inside-work-tree 2>/dev/null) ||
    die 'current directory is not inside a Git repository'
  [ "$inside" = true ] || die 'current directory is not inside a Git work tree'

  local origin rest host path identity repo_name slug digest
  origin=$(git config --get remote.origin.url 2>/dev/null) ||
    die 'current repository has no origin remote'
  [ -n "$origin" ] || die 'current repository has no origin remote'

  case "$origin" in
    ssh://*|https://*)
      rest=${origin#*://}
      case "$rest" in
        *@*) rest=${rest#*@} ;;
      esac
      host=${rest%%/*}
      [ "$host" != "$rest" ] || die 'origin remote has no repository path'
      path=${rest#*/}
      ;;
    *:*)
      rest=$origin
      case "$rest" in
        *@*) rest=${rest#*@} ;;
      esac
      host=${rest%%:*}
      path=${rest#*:}
      ;;
    *)
      die 'origin remote must use SSH or HTTPS'
      ;;
  esac

  path=${path%%\?*}
  path=${path%%\#*}
  while [ "${path#/}" != "$path" ]; do path=${path#/}; done
  while [ "${path%/}" != "$path" ]; do path=${path%/}; done
  path=${path%.git}
  [ -n "$host" ] && [ -n "$path" ] || die 'origin remote has no repository identity'

  identity=$(printf '%s/%s' "$host" "$path" | tr '[:upper:]' '[:lower:]')
  repo_name=${path##*/}
  slug=$(printf '%s' "$repo_name" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//')
  [ -n "$slug" ] || die 'origin remote has no path-safe repository name'

  if command -v shasum >/dev/null 2>&1; then
    digest=$(printf '%s' "$identity" | shasum -a 256 | sed 's/[[:space:]].*$//')
  elif command -v sha256sum >/dev/null 2>&1; then
    digest=$(printf '%s' "$identity" | sha256sum | sed 's/[[:space:]].*$//')
  else
    die 'required SHA-256 command not found'
  fi
  printf 'ctx:%s-%s\n' "$slug" "${digest:0:10}"
}

bootstrap() {
  local prefix=$1
  need bd
  need git
  need jq
  [ ! -e "$store" ] || die "store already exists: $store"
  [ -d "$HOME" ] && [ -w "$HOME" ] || die "HOME is not writable: $HOME"

  umask 077
  mkdir -p "$parent" || die "cannot create store parent: $parent"
  [ -d "$parent" ] && [ -w "$parent" ] || die "store parent is not writable: $parent"
  if git -C "$parent" rev-parse --git-dir >/dev/null 2>&1; then
    die "store parent must be outside every Git repository: $parent"
  fi

  if (
    cd "$parent" &&
      run_bd_bootstrap metrics off &&
      run_bd_bootstrap init \
        --prefix "$prefix" \
        --non-interactive \
        --skip-hooks \
        --skip-agents &&
       run_bd config set export.auto false &&
       run_bd config set export.git-add false &&
       run_bd config set dolt.auto-push false &&
        ensure_hub_config
  ); then
    return 0
  else
    status=$?
  fi

  rm -rf -- "$store"
  return "$status"
}

safe_value() {
  [ -n "$2" ] || die "missing value for $1"
  case "$2" in
    *$'\n'*|*$'\r'*|*$'\t'*) die "invalid control character in $1" ;;
  esac
}

safe_id() {
  safe_value "$1" "$2"
  case "$2" in -*) die "invalid ID for $1: $2" ;; esac
}

mark_seen() {
  case " $seen " in
    *" $1 "*) die "duplicate option: $1" ;;
  esac
  seen="$seen $1"
}

set_json() {
  $json && die 'duplicate option: --json'
  json=true
}

validate_priority() {
  case "$1" in 0|1|2|3|4|P0|P1|P2|P3|P4) ;; *) die "invalid priority: $1" ;; esac
}

validate_type() {
  case "$1" in bug|feature|task|epic|chore|decision) ;; *) die "invalid issue type: $1" ;; esac
}

validate_statuses() {
  local value=$1 status
  case "$value" in ,*|*,|*,,*) die 'status list contains an empty value' ;; esac
  IFS=, read -r -a statuses <<<"$value"
  [ "${#statuses[@]}" -gt 0 ] || die 'status list must not be empty'
  for status in "${statuses[@]}"; do
    case "$status" in open|in_progress|blocked|deferred|closed) ;; *) die "invalid status: $status" ;; esac
  done
}

validate_labels() {
  local value=$1 label checked
  case "$value" in ,*|*,|*,,*) die 'label list contains an empty value' ;; esac
  IFS=, read -r -a labels <<<"$value"
  [ "${#labels[@]}" -gt 0 ] || die 'label list must not be empty'
  for label in "${labels[@]}"; do
    safe_value label "$label"
    case "$label" in *'"'*) die 'quoted labels are unsupported' ;; esac
    checked=$label
    while [[ $checked == ' '* ]]; do checked=${checked# }; done
    [ -n "$checked" ] || die 'label list contains an empty value'
    case "$checked" in ctx:*) die 'ctx: labels are wrapper-owned' ;; esac
  done
}

validate_query_labels() {
  local value=$1 label
  case "$value" in ,*|*,|*,,*) die 'label list contains an empty value' ;; esac
  IFS=, read -r -a labels <<<"$value"
  [ "${#labels[@]}" -gt 0 ] || die 'label list must not be empty'
  for label in "${labels[@]}"; do safe_value label "$label"; done
}

validate_limit() {
  [[ $1 =~ ^[0-9]+$ ]] && [ "${#1}" -le 4 ] || die "invalid limit: $1"
  ((10#$1 >= 1 && 10#$1 <= 1000)) || die 'limit must be between 1 and 1000'
}

validate_prefix() {
  local prefix=$1
  case "$prefix" in *--*) die 'prefix must not contain consecutive hyphens' ;; esac
  [ "${#prefix}" -le 32 ] && [[ $prefix =~ ^[a-z]([a-z0-9-]{0,30}[a-z0-9])?$ ]] ||
    die 'prefix must be 1-32 lowercase ASCII letters, digits, or hyphens, start with a letter, and end with a letter or digit'
}

json=false
if [ "${1:-}" = --json ]; then
  json=true
  shift
fi

command_name=${1:-}
[ -n "$command_name" ] ||
  die 'supported commands: bootstrap, configure, register, context, create, new, list, show, update, dep, close, reopen, link'
case "$command_name" in -*) die "unsupported global option: $command_name" ;; esac
shift

if [ "$command_name" = bootstrap ]; then
  ! $json || die 'usage: wbd bootstrap [--prefix <prefix>]'
  prefix=bead
  if [ "$#" -gt 0 ]; then
    [ "$#" -eq 2 ] && [ "$1" = --prefix ] || die 'usage: wbd bootstrap [--prefix <prefix>]'
    prefix=$2
  fi
  validate_prefix "$prefix"
  bootstrap "$prefix"
  exit 0
fi

[ -d "$store" ] || die "store is missing; run 'wbd bootstrap'"
need bd

global_args=()
$json && global_args+=(--json)

case "$command_name" in
  context)
    ! $json && [ "$#" -eq 0 ] || die 'usage: wbd context'
    context
    ;;
  configure)
    ! $json && [ "$#" -eq 0 ] || die 'usage: wbd configure'
    ensure_hub_config
    printf '%s\n' "$hub_config"
    ;;
  register)
    ! $json && [ "$#" -eq 0 ] || die 'usage: wbd register'
    register_repository
    printf '%s\t%s\n' "$registered_context" "$registered_root"
    ;;
  create|new)
    seen=
    args=()
    titles=()
    while [ "$#" -gt 0 ]; do
      arg=$1
      shift
      case "$arg" in
        --json) set_json ;;
        --description|--type|--priority|--labels)
          [ "$#" -gt 0 ] || die "missing value for $arg"
          value=$1
          shift
          safe_value "$arg" "$value"
          case "$arg" in
            --type) mark_seen "$arg"; validate_type "$value" ;;
            --priority) mark_seen "$arg"; validate_priority "$value" ;;
            --labels) validate_labels "$value" ;;
            *) mark_seen "$arg" ;;
          esac
          args+=("$arg" "$value")
          ;;
        --description=*|--type=*|--priority=*|--labels=*)
          flag=${arg%%=*}
          value=${arg#*=}
          safe_value "$flag" "$value"
          case "$flag" in
            --type) mark_seen "$flag"; validate_type "$value" ;;
            --priority) mark_seen "$flag"; validate_priority "$value" ;;
            --labels) validate_labels "$value" ;;
            *) mark_seen "$flag" ;;
          esac
          args+=("$flag" "$value")
          ;;
        -*) die "unsupported option for $command_name: $arg" ;;
        *) safe_value title "$arg"; titles+=("$arg") ;;
      esac
    done
    [ "${#titles[@]}" -eq 1 ] || die "usage: wbd $command_name <title> [options]"
    global_args=()
    $json && global_args+=(--json)
    register_repository
    run_bd ${global_args[@]+"${global_args[@]}"} "$command_name" --labels "$registered_context" "${titles[0]}" ${args[@]+"${args[@]}"}
    ;;
  list)
    seen=
    args=()
    all_contexts=false
    while [ "$#" -gt 0 ]; do
      arg=$1
      shift
      case "$arg" in
        --json) set_json ;;
        --all-contexts) mark_seen "$arg"; all_contexts=true ;;
        --ready) mark_seen "$arg"; args+=("$arg") ;;
        --status|--type|--priority|--label|--limit)
          [ "$#" -gt 0 ] || die "missing value for $arg"
          value=$1
          shift
          safe_value "$arg" "$value"
          case "$arg" in
            --status) mark_seen "$arg"; validate_statuses "$value" ;;
            --type) mark_seen "$arg"; validate_type "$value" ;;
            --priority) mark_seen "$arg"; validate_priority "$value" ;;
            --label) validate_query_labels "$value" ;;
            --limit) mark_seen "$arg"; validate_limit "$value" ;;
          esac
          args+=("$arg" "$value")
          ;;
        --status=*|--type=*|--priority=*|--label=*|--limit=*)
          flag=${arg%%=*}
          value=${arg#*=}
          safe_value "$flag" "$value"
          case "$flag" in
            --status) mark_seen "$flag"; validate_statuses "$value" ;;
            --type) mark_seen "$flag"; validate_type "$value" ;;
            --priority) mark_seen "$flag"; validate_priority "$value" ;;
            --label) validate_query_labels "$value" ;;
            --limit) mark_seen "$flag"; validate_limit "$value" ;;
          esac
          args+=("$flag" "$value")
          ;;
        -*) die "unsupported option for list: $arg" ;;
        *) die "list does not accept positional arguments: $arg" ;;
      esac
    done
    global_args=()
    $json && global_args+=(--json)
    if $all_contexts; then
      run_bd ${global_args[@]+"${global_args[@]}"} list ${args[@]+"${args[@]}"}
    else
      register_repository
      run_bd ${global_args[@]+"${global_args[@]}"} list --label "$registered_context" ${args[@]+"${args[@]}"}
    fi
    ;;
  show)
    ids=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --json) set_json ;;
        -*) die "unsupported option for show: $1" ;;
        *) safe_id show "$1"; ids+=("$1") ;;
      esac
      shift
    done
    [ "${#ids[@]}" -eq 1 ] || die 'usage: wbd show <id> [--json]'
    global_args=()
    $json && global_args+=(--json)
    run_bd ${global_args[@]+"${global_args[@]}"} show "${ids[0]}"
    ;;
  update)
    seen=
    args=()
    ids=()
    mutations=0
    while [ "$#" -gt 0 ]; do
      arg=$1
      shift
      case "$arg" in
        --json) set_json ;;
        --title|--description|--type|--priority|--status|--add-label)
          [ "$#" -gt 0 ] || die "missing value for $arg"
          value=$1
          shift
          safe_value "$arg" "$value"
          case "$arg" in
            --type) mark_seen "$arg"; validate_type "$value" ;;
            --priority) mark_seen "$arg"; validate_priority "$value" ;;
            --status)
              mark_seen "$arg"
              case "$value" in open|in_progress|blocked|deferred) ;; *) die "invalid update status: $value" ;; esac
              ;;
            --add-label) validate_labels "$value" ;;
            *) mark_seen "$arg" ;;
          esac
          args+=("$arg" "$value")
          mutations=$((mutations + 1))
          ;;
        --title=*|--description=*|--type=*|--priority=*|--status=*|--add-label=*)
          flag=${arg%%=*}
          value=${arg#*=}
          safe_value "$flag" "$value"
          case "$flag" in
            --type) mark_seen "$flag"; validate_type "$value" ;;
            --priority) mark_seen "$flag"; validate_priority "$value" ;;
            --status)
              mark_seen "$flag"
              case "$value" in open|in_progress|blocked|deferred) ;; *) die "invalid update status: $value" ;; esac
              ;;
            --add-label) validate_labels "$value" ;;
            *) mark_seen "$flag" ;;
          esac
          args+=("$flag" "$value")
          mutations=$((mutations + 1))
          ;;
        -*) die "unsupported option for update: $arg" ;;
        *) safe_id update "$arg"; ids+=("$arg") ;;
      esac
    done
    [ "${#ids[@]}" -eq 1 ] && [ "$mutations" -gt 0 ] || die 'usage: wbd update <id> <mutation> [--json]'
    global_args=()
    $json && global_args+=(--json)
    run_bd ${global_args[@]+"${global_args[@]}"} update "${ids[0]}" ${args[@]+"${args[@]}"}
    ;;
  dep)
    subcommand=${1:-}
    case "$subcommand" in add|remove) ;; *) die 'usage: wbd dep add|remove <issue-id> <depends-on-id> [options]' ;; esac
    shift
    seen=
    args=()
    ids=()
    while [ "$#" -gt 0 ]; do
      arg=$1
      shift
      case "$arg" in
        --json) set_json ;;
        --type)
          [ "$subcommand" = add ] || die '--type is supported only for dep add'
          [ "$#" -gt 0 ] || die 'missing value for --type'
          value=$1
          shift
          safe_value --type "$value"
          mark_seen --type
          case "$value" in blocks|tracks|related|parent-child|discovered-from|until|caused-by|validates|relates-to|supersedes) ;; *) die "invalid dependency type: $value" ;; esac
          args+=(--type "$value")
          ;;
        --type=*)
          [ "$subcommand" = add ] || die '--type is supported only for dep add'
          value=${arg#*=}
          safe_value --type "$value"
          mark_seen --type
          case "$value" in blocks|tracks|related|parent-child|discovered-from|until|caused-by|validates|relates-to|supersedes) ;; *) die "invalid dependency type: $value" ;; esac
          args+=(--type "$value")
          ;;
        -*) die "unsupported option for dep $subcommand: $arg" ;;
        *) safe_id "dep $subcommand" "$arg"; ids+=("$arg") ;;
      esac
    done
    [ "${#ids[@]}" -eq 2 ] || die "usage: wbd dep $subcommand <issue-id> <depends-on-id> [options]"
    global_args=()
    $json && global_args+=(--json)
    run_bd ${global_args[@]+"${global_args[@]}"} dep "$subcommand" "${ids[@]}" ${args[@]+"${args[@]}"}
    ;;
  close|reopen)
    seen=
    args=()
    ids=()
    while [ "$#" -gt 0 ]; do
      arg=$1
      shift
      case "$arg" in
        --json) set_json ;;
        --reason)
          [ "$#" -gt 0 ] || die 'missing value for --reason'
          value=$1
          shift
          safe_value --reason "$value"
          mark_seen --reason
          args+=(--reason "$value")
          ;;
        --reason=*)
          value=${arg#*=}
          safe_value --reason "$value"
          mark_seen --reason
          args+=(--reason "$value")
          ;;
        -*) die "unsupported option for $command_name: $arg" ;;
        *) safe_id "$command_name" "$arg"; ids+=("$arg") ;;
      esac
    done
    [ "${#ids[@]}" -eq 1 ] || die "usage: wbd $command_name <id> [--reason <text>] [--json]"
    global_args=()
    $json && global_args+=(--json)
    run_bd ${global_args[@]+"${global_args[@]}"} "$command_name" "${ids[0]}" ${args[@]+"${args[@]}"}
    ;;
  link)
    ! $json && [ "$#" -ge 1 ] && [ "$#" -le 2 ] || die 'usage: wbd link <bead-id> [commit]'
    safe_id link "$1"
    commit=${2:-HEAD}
    safe_value commit "$commit"
    case "$commit" in -*) die "invalid commit: $commit" ;; esac
    need bv
    register_repository
    run_bv correlate add \
      --bead "$1" \
      --repo "$registered_context" \
      --commit "$commit" \
      --hub-config "$hub_config"
    ;;
  init)
    die "direct init is disabled; run 'wbd bootstrap'"
    ;;
  *)
    die 'supported commands: bootstrap, configure, register, context, create, new, list, show, update, dep, close, reopen, link'
    ;;
esac

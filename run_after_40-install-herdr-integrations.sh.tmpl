#!/bin/sh
set -eu

{{- if and .modules.herdr .modules.opencode }}
if ! herdr integration status | grep '^opencode: current ' >/dev/null; then
  herdr integration install opencode
fi
{{- end }}

{{- if and .modules.herdr .modules.shell }}
completion_dir="$HOME/.zsh/completions"
mkdir -p "$completion_dir"
tmp=$(mktemp)
herdr completion zsh >"$tmp"
if [ ! -f "$completion_dir/_herdr" ] || ! cmp -s "$tmp" "$completion_dir/_herdr"; then
  mv "$tmp" "$completion_dir/_herdr"
else
  rm -f "$tmp"
fi
{{- end }}

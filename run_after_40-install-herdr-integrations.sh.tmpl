#!/bin/sh
set -eu

{{- if and .modules.herdr .modules.opencode }}
if ! herdr integration status | grep -q '^opencode: current '; then
  herdr integration install opencode
fi
{{- end }}

{{- if and .modules.herdr .modules.shell }}
completion_dir="$HOME/.zsh/completions"
mkdir -p "$completion_dir"
tmp=$(mktemp)
herdr completion zsh >"$tmp"
if [ ! -f "$completion_dir/_herdr" ] || ! cmp -s "$tmp" "$completion_dir/_herdr"; then
  mv "$tmp" "$completion_dir/_herdr"
else
  rm -f "$tmp"
fi
{{- end }}

{{- if and .modules.opencode .modules.shell }}
if command -v codex >/dev/null 2>&1; then
  completion_dir="$HOME/.zsh/completions"
  mkdir -p "$completion_dir"
  codex_tmp=$(mktemp)
  codex completion zsh >"$codex_tmp"
  if [ ! -f "$completion_dir/_codex" ] || ! cmp -s "$codex_tmp" "$completion_dir/_codex"; then
    mv "$codex_tmp" "$completion_dir/_codex"
  else
    rm -f "$codex_tmp"
  fi
fi
{{- end }}

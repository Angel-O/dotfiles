{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight-mauve",
    "mode": "dark"
  },
  "diffs": {
    "fullscreen": false,
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "unified"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": true,
    "tps": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "animations": true{{ if .modules.herdr }},
  "plugins": [
    "./herdr-opencode"
  ]{{ end }},
  "tabs": {
    "layout": "horizontal",
    "mode": "auto",
    "indicators": "status",
    "scope": "cwd"
  },
  "prompt": {
    "image_preview": true,
    "paste": "compact"
  },
  "scroll": {
    "acceleration": false,
    "speed": 3
  },
  "attention": {
    "notifications": false,
    "sound": false
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": true,
    "timing": false,
    "turn_tokens": true
  },
  "experimental": {
    "new-designs": true,
    "client-mcp": true
  }
}

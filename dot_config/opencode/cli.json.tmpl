{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight-mauve",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "unified"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": false
  },
  "animations": true{{ if .modules.herdr }},
  "plugins": [
    "./herdr-opencode"
  ]{{ end }},
  "tabs": {
    "layout": "horizontal",
    "mode": "auto",
    "indicators": "status"
  },
  "prompt": {
    "image_preview": false
  },
  "scroll": {
    "acceleration": false
  },
  "attention": {
    "notifications": false,
    "sound": false
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": true
  }
}

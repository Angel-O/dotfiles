#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'sync failed: %s\n' "$1" >&2
  exit 1
}

if [[ $# -ne 2 ]]; then
  printf 'usage: sync-reference <full-pr-url> <recorded-reference-checkout>\n' >&2
  exit 2
fi

pr_url=$1
checkout=$2
if [[ ! $pr_url =~ ^https://github\.com/[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$ ]]; then
  printf 'usage: sync-reference <full-pr-url> <recorded-reference-checkout>\n' >&2
  printf '%s\n' 'sync failed: pull request selector must be a full GitHub pull-request URL' >&2
  exit 2
fi
[[ $checkout == /* && -d $checkout ]] || die 'recorded reference checkout is unavailable'
checkout=$(cd -- "$checkout" && pwd -P) || die 'cannot resolve recorded reference checkout'
repo_root=$(git -C "$checkout" rev-parse --show-toplevel 2>/dev/null) ||
  die 'recorded reference checkout is not a Git repository'
repo_root=$(cd -- "$repo_root" && pwd -P) || die 'cannot resolve reference repository root'
[[ $repo_root == "$checkout" ]] || die 'recorded path is not the reference checkout root'

pr_json=$(gh pr view "$pr_url" --json state,mergedAt,mergeCommit,baseRefName 2>/dev/null) ||
  die 'cannot read pull request'
pr_fields=$(python3 -c '
import json, re, sys
try:
    pr = json.load(sys.stdin)
    state = pr["state"]
    merged_at = pr["mergedAt"]
    merge_sha = pr["mergeCommit"]["oid"]
    base = pr["baseRefName"]
    if (state != "MERGED" or not isinstance(merged_at, str) or not merged_at or
            not isinstance(merge_sha, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", merge_sha) or
            not isinstance(base, str) or not base or
            any(c in value for value in (state, merged_at, merge_sha, base) for c in "\t\r\n")):
        raise ValueError
    print("\t".join((state, merged_at, merge_sha.lower(), base)))
except (KeyError, TypeError, ValueError, json.JSONDecodeError):
    sys.exit(1)
' <<<"$pr_json") || die 'pull request is not a valid merged result'
IFS=$'\t' read -r pr_state merged_at merge_sha base_branch <<<"$pr_fields"
[[ $pr_state == MERGED && -n $merged_at && ${#merge_sha} -eq 40 && -n $base_branch ]] ||
  die 'pull request is not a valid merged result'
git -C "$checkout" check-ref-format "refs/heads/$base_branch" >/dev/null 2>&1 ||
  die 'pull request base branch is invalid'

current_branch=$(git -C "$checkout" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
  die 'reference checkout must be on a branch'
[[ $current_branch == "$base_branch" ]] || die 'reference checkout is not on the PR base branch'
status=$(git -C "$checkout" status --porcelain=v1 --untracked-files=all 2>/dev/null) ||
  die 'cannot verify reference checkout cleanliness'
[[ -z $status ]] || die 'reference checkout is not clean'

git -C "$checkout" fetch --no-tags origin "refs/heads/$base_branch" >/dev/null 2>&1 ||
  die 'cannot fetch the PR base branch'
git -C "$checkout" rev-parse --verify --quiet 'FETCH_HEAD^{commit}' >/dev/null ||
  die 'fetched PR base is not a commit'
git -C "$checkout" merge-base --is-ancestor HEAD FETCH_HEAD >/dev/null 2>&1 ||
  die 'reference HEAD is not in the fetched base history'
git -C "$checkout" merge-base --is-ancestor "$merge_sha" FETCH_HEAD >/dev/null 2>&1 ||
  die 'PR merge result is not in the fetched base history'

status=$(git -C "$checkout" status --porcelain=v1 --untracked-files=all 2>/dev/null) ||
  die 'cannot verify a clean reference checkout before pull'
[[ -z $status ]] || die 'reference checkout is not clean before pull'
git -C "$checkout" pull --ff-only origin "$base_branch" >/dev/null 2>&1 ||
  die 'fast-forward-only pull failed; reference synchronization did not complete'

printf 'sync complete: merge %s on base branch %s; reference synchronized\n' \
  "$merge_sha" "$base_branch"

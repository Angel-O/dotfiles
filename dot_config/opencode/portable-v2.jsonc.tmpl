{
  "$schema": "https://opencode.ai/config.json",
  // V2 package declarations live here. Local plugins are discovered from
  // plugins/ and are deliberately not duplicated in this list.
  "plugin": [
    "@slkiser/opencode-quota@{{ .pins.openCodePlugins.quotaV2 }}",
    "@plannotator/opencode@{{ .pins.openCodePlugins.plannotator }}"
  ],
  "agent": {
    "title": {
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "none"
      }
    }
  }{{ if eq .role "personal" }},
  "disabled_providers": ["opencode"],
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      }
    }
  }{{ end }}
}

{{- $opencodeBeads := dig "integrations" "opencodeBeads" false . -}}
#!/bin/sh
set -eu

old_start='<!-- portable-work-beads:start -->'
old_end='<!-- portable-work-beads:end -->'
start='<!-- portable-beads-hub:start -->'
end='<!-- portable-beads-hub:end -->'
repository_heading='## REPOSITORY ROOT'
repository_line='When locating a named local repository, look under ~/workspace/source/.'
validation_start='<!-- meaningful-validation:start -->'
validation_end='<!-- meaningful-validation:end -->'
tmp=$(mktemp)
clean=$(mktemp)
repository_clean=$(mktemp)
trap 'rm -f "$tmp" "$clean" "$repository_clean"' EXIT
cat >"$tmp"

if awk -v old_start="$old_start" -v old_end="$old_end" -v start="$start" -v end="$end" -v validation_start="$validation_start" -v validation_end="$validation_end" '
  {
    marker = $0
    sub(/\r$/, "", marker)
  }
  marker == old_start || marker == start || marker == validation_start {
    if (inside) {
      malformed = 12
      exit malformed
    }
    kind = marker == validation_start ? "validation" : "hub"
    if (seen[kind]++) {
      malformed = 14
      exit malformed
    }
    current = kind
    inside = 1
    next
  }
  marker == old_end || marker == end || marker == validation_end {
    if (!inside) {
      malformed = 13
      exit malformed
    }
    inside = 0
    if ((current == "validation" && marker != validation_end) || (current == "hub" && marker == validation_end)) {
      malformed = 14
      exit malformed
    }
  }
  END {
    if (!malformed && inside) exit 11
  }
' "$tmp"; then
  :
else
  status=$?
  case "$status" in
    11) reason='unmatched start marker' ;;
    12) reason='nested start marker' ;;
    13) reason='orphan end marker' ;;
    14) reason='multiple managed blocks' ;;
    *) reason='marker validation failed' ;;
  esac
  printf 'beads-hub AGENTS modifier: %s\n' "$reason" >&2
  cat "$tmp"
  exit 1
fi

awk -v old_start="$old_start" -v old_end="$old_end" -v start="$start" -v end="$end" -v validation_start="$validation_start" -v validation_end="$validation_end" '
  {
    marker = $0
    sub(/\r$/, "", marker)
  }
  marker == old_start || marker == start || marker == validation_start {
    inside = 1
    next
  }
  inside {
    if (marker == old_end || marker == end || marker == validation_end) {
      inside = 0
    }
    next
  }
  { print }
' "$tmp" >"$clean"

awk -v repository_heading="$repository_heading" -v repository_line="$repository_line" '
  {
    line = $0
    sub(/\r$/, "", line)
  }
  line == repository_heading || line == repository_line {
    next
  }
  { print }
' "$clean" >"$repository_clean"

cat "$repository_clean"
{{- if and .modules.beads $opencodeBeads }}
if [ -s "$repository_clean" ] && [ -n "$(tail -c 1 "$repository_clean")" ]; then
  printf '\n'
fi
cat <<'BLOCK'
<!-- portable-beads-hub:start -->
## Private Beads Hub

For explicitly requested private Beads tracking, or work that already references a Bead ID, load the global `beads-hub` skill before acting. Follow its contract; use only `wbd` and approved `wbv --robot-*` queries, never raw `bd`, `bv`, or `br`.

Commit correlation and Bead closure must not occur during implementation, commit, push, or PR creation. Perform both only after the change is merged, through the `beads-hub-closeout` workflow.

Only after `beads-hub-closeout` reports `closeout complete`, invoke `tracking_closeout({ beadID })` with the same exact private Bead ID. Never invoke it for a failed or partial Hub closeout. Tracker or report-rendering failures must not undo or block successful Hub closeout.
<!-- portable-beads-hub:end -->
BLOCK
{{- end }}
if [ -s "$repository_clean" ] && [ -n "$(tail -c 1 "$repository_clean")" ]; then
  printf '\n'
fi
cat <<'BLOCK'
<!-- meaningful-validation:start -->
## Meaningful validation

### Canonical test strategy (TEST-01–06)

- **TEST-01 — Behavior:** Trace tests to requested behavior and user stories. Assert externally observable outcomes and preserve meaningful coverage; do not use ordinary behavioral tests to require source/test-file hashes, review receipts, or orchestration approval flags as bookkeeping. Hashes remain valid for genuine product behavior, data-preservation assertions, or justified external-tool integrity requirements.
- **TEST-02 — Work-type strategy:** For established behavior changes and reproducible bugs, write behavioral tests and show meaningful red before the fix when practical; compile, setup, or environment failures are not meaningful red. For refactors, run a passing behavioral baseline and add passing characterization coverage for material gaps. For greenfield projects or genuinely new components, test-first is optional, but meaningful coverage is required before acceptance. Documentation-only work needs accuracy/consistency review, not artificial tests. For operational resource/configuration changes, use proportionate rendering or behavioral verification; deployment evidence is required only when agreed or needed to establish the specified outcome. Do not manufacture a failing application test for a configuration-value change.
- **TEST-03 — Stable contracts and test cleanup:** Prefer stable observable contracts over implementation details. Exact string or byte comparisons are appropriate only when exact representation is itself contractual. Diagnose test/fixture failures before changing expectations; never weaken meaningful assertions merely to get green. For test-only cleanup, evaluate the reason and retained behavioral coverage; remove assertions shown to cover only non-behavioral provenance/bookkeeping when explained, while preserving meaningful behavior coverage. Test deletion does not require an artificial failing-red demonstration.
- **TEST-04 — Scope before work:** Before authoring or running tests, changing/removing executable test coverage, or implementing applicable behavioral work, the worker proposes proportionate test scope and invokes exactly one `test-scope-reviewer` subagent for an initial scope-only assessment. A behavioral change cannot claim the no-test-scope exemption merely because the proposal contains no tests; the reviewer must assess that omission. For test cleanup, the proposal includes the removal rationale and retained behavioral coverage, which the same initial review vets before edits; deletion does not require an artificial red run. Skip invocation only for documentation-only work or work that genuinely changes no relevant behavior and has no test scope to vet. The reviewer loads `ponytail`, checks the proposal against these rules, and returns actionable findings with a conclusive `PASS` or `REVISE`; it does not run tests, edit code, perform discovery, or approve delivery. Address necessary feedback before proceeding and escalate unresolved behavior/scope decisions. If the child cannot be invoked, fails, is unavailable, or returns no conclusive result, stop and report the blocker; do not bypass, substitute another review path, or repeat the embedded review. Do not repeat this review for later edits.
- **TEST-05 — Diagnose failures:** Classify failures as product behavior, test/fixture, environment, or evidence failures. Repair tests/fixtures only after diagnosis and preserve relevant behavioral assertions; distinguish unrelated pre-existing failures and rerun affected checks after corrections.
- **TEST-06 — Honest evidence:** Report criterion-level evidence from the delivered revision, exact checks/results, limitations, and QA/waiver status. Not run, blocked, or inconclusive is not passed. Focused checks belong to workers; integration owns agreed broader checks; the paired final reviewer is static-only and assesses delivered tests for behavioral coverage and brittleness. It does not redesign the strategy. Human QA is only for judgment/access limits, with agreed steps, expected result, owner, and blocking stage.

Before implementation, agree a concise strategy and validation plan with the user for each epic or standalone implementation Bead, including behavior/risks, work-type strategy, checks/owner/environment, pass criteria, limitations, and blocking stages. Record it in the existing `Validation` section. For non-Bead work, agree the same relevant strategy and pass it in the worker brief; do not create a Bead solely to carry it. An epic's initial strategy is recorded before architecture; each concrete slice inherits the relevant strategy and identifies task-specific behavior. Bug investigation supplies reproduction evidence; the controller ensures the concrete Bead records the strategy. The controller passes the selected strategy in the worker brief. Material deviations require user agreement. Remove or weaken tests only for obsolete behavior, demonstrated redundancy, or equivalent/better replacement coverage; explain why, never merely to make checks pass. Rendering, installation, and content-preservation checks apply when executable templates or installation logic change, not to test their prose. Agents run reasonably available, reliable, safe programmatic checks. Replacing promised automation with human QA requires agreement.

Approval/considered done requires acceptance-criterion evidence from the delivered revision, passed required checks, completed required QA, and disclosed limitations. Not run, blocked, or inconclusive is not passed. Only the user may waive a required gate; record missing evidence, risk, and affected gate, never as a pass. Classify pre-existing failures and selectively rerun affected checks after corrections. Workers own focused checks, integration supplied broader checks when warranted, and reviewers static assessment only. Validate an epic's own outcome, not just child completion. CI/branch protection and release gates are separate; these instructions neither guarantee model compliance nor technically prevent direct Hub closure.

## Tools guardrails

Never invoke `handoff_session` spontaneously; invoke it only when the user explicitly requests a session handoff.

## OpenCode service management

For an agent model override, run `/restart-opencode-env`. After interruption, check `~/.local/bin/opencode-env-restart status <run-id>` (or `status` for the latest run) before retrying. Report activation only after a successful receipt and live selector match from `~/.local/bin/opencode-env api get /api/agent`.
<!-- meaningful-validation:end -->
BLOCK
if [ -s "$repository_clean" ] && [ -n "$(tail -c 1 "$repository_clean")" ]; then
  printf '\n'
fi
printf '%s\n%s\n' "$repository_heading" "$repository_line"

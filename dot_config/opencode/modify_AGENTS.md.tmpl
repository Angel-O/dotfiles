{{- $opencodeBeads := dig "integrations" "opencodeBeads" false . -}}
#!/bin/sh
set -eu

old_start='<!-- portable-work-beads:start -->'
old_end='<!-- portable-work-beads:end -->'
start='<!-- portable-beads-hub:start -->'
end='<!-- portable-beads-hub:end -->'
repository_heading='## REPOSITORY ROOT'
repository_line='When locating a named local repository, look under ~/workspace/source/.'
validation_start='<!-- meaningful-validation:start -->'
validation_end='<!-- meaningful-validation:end -->'
tmp=$(mktemp)
clean=$(mktemp)
repository_clean=$(mktemp)
trap 'rm -f "$tmp" "$clean" "$repository_clean"' EXIT
cat >"$tmp"

if awk -v old_start="$old_start" -v old_end="$old_end" -v start="$start" -v end="$end" -v validation_start="$validation_start" -v validation_end="$validation_end" '
  {
    marker = $0
    sub(/\r$/, "", marker)
  }
  marker == old_start || marker == start || marker == validation_start {
    if (inside) {
      malformed = 12
      exit malformed
    }
    kind = marker == validation_start ? "validation" : "hub"
    if (seen[kind]++) {
      malformed = 14
      exit malformed
    }
    current = kind
    inside = 1
    next
  }
  marker == old_end || marker == end || marker == validation_end {
    if (!inside) {
      malformed = 13
      exit malformed
    }
    inside = 0
    if ((current == "validation" && marker != validation_end) || (current == "hub" && marker == validation_end)) {
      malformed = 14
      exit malformed
    }
  }
  END {
    if (!malformed && inside) exit 11
  }
' "$tmp"; then
  :
else
  status=$?
  case "$status" in
    11) reason='unmatched start marker' ;;
    12) reason='nested start marker' ;;
    13) reason='orphan end marker' ;;
    14) reason='multiple managed blocks' ;;
    *) reason='marker validation failed' ;;
  esac
  printf 'beads-hub AGENTS modifier: %s\n' "$reason" >&2
  cat "$tmp"
  exit 1
fi

awk -v old_start="$old_start" -v old_end="$old_end" -v start="$start" -v end="$end" -v validation_start="$validation_start" -v validation_end="$validation_end" '
  {
    marker = $0
    sub(/\r$/, "", marker)
  }
  marker == old_start || marker == start || marker == validation_start {
    inside = 1
    next
  }
  inside {
    if (marker == old_end || marker == end || marker == validation_end) {
      inside = 0
    }
    next
  }
  { print }
' "$tmp" >"$clean"

awk -v repository_heading="$repository_heading" -v repository_line="$repository_line" '
  {
    line = $0
    sub(/\r$/, "", line)
  }
  line == repository_heading || line == repository_line {
    next
  }
  { print }
' "$clean" >"$repository_clean"

cat "$repository_clean"
{{- if and .modules.beads $opencodeBeads }}
if [ -s "$repository_clean" ] && [ -n "$(tail -c 1 "$repository_clean")" ]; then
  printf '\n'
fi
cat <<'BLOCK'
<!-- portable-beads-hub:start -->
## Private Beads Hub

For explicitly requested private Beads tracking, or work that already references a Bead ID, load the global `beads-hub` skill before acting. Follow its contract; use only `wbd` and approved `wbv --robot-*` queries, never raw `bd`, `bv`, or `br`.

Commit correlation and Bead closure must not occur during implementation, commit, push, or PR creation. Perform both only after the change is merged, through the `beads-hub-closeout` workflow.

Only after `beads-hub-closeout` reports `closeout complete`, invoke `tracking_closeout({ beadID })` with the same exact private Bead ID. Never invoke it for a failed or partial Hub closeout. Tracker or report-rendering failures must not undo or block successful Hub closeout.
<!-- portable-beads-hub:end -->
BLOCK
{{- end }}
if [ -s "$repository_clean" ] && [ -n "$(tail -c 1 "$repository_clean")" ]; then
  printf '\n'
fi
cat <<'BLOCK'
<!-- meaningful-validation:start -->
## Meaningful validation

Agree a concise validation plan with the user for each epic or standalone implementation Bead before work starts: relevant behavior and risks, checks and owner/environment, observable pass criteria, and known limits or blocking stages. Children inherit the strategy and add only relevant checks; seek agreement only for material deviations. Validation must exercise changed behavior and acceptance criteria; existing coverage may suffice. Documentation-only changes require no tests: review accuracy and consistency without adding or running tests merely because prose changed. Rendering, installation, and content-preservation checks are justified when executable templates or installation logic change, not to test the documentation they contain; actual executable workflow/template changes still receive relevant behavioral validation. Agents perform reliable, reasonably available, safe programmatic verification. Human QA is for judgment, unavailable access, physical interaction, or environments agents cannot safely exercise—not complexity alone. Agree QA steps, expected results, owner, and blocking stage. Replacing promised automated verification with human QA is a material deviation requiring user agreement.

For bug fixes, where practical demonstrate that the regression check fails on buggy behavior and passes after the fix. Assess whether a plausible incorrect implementation would fail and whether important behavior was mocked away. Distinguish one-off verification from retained regression protection; changed nontrivial behavior generally needs durable coverage. Avoid blanket layers, coverage quotas, incidental prose assertions, arbitrary sleeps, and assertions on noncontractual internal ordering. Preserve exact strings only when they are contractual; existing coverage may suffice.

Approval/considered done requires criterion-by-criterion evidence from the delivered revision, passed required checks, completed required human QA, and disclosed limitations. Not run, blocked, or inconclusive is not passed. Only the user may explicitly waive a required gate; record missing evidence, risk, and affected gate, and never report waived checks as passing. Classify pre-existing failures, rerun affected checks after corrections, and broaden reruns only when impact warrants. Review is static; workers run focused checks; integration owns supplied broader checks when warranted. Epic completion requires validating its own outcome, not just completed children. CI/branch protection and release gates are separate enforcement stages: these instructions do not guarantee model compliance or technically prevent direct Hub closure.
<!-- meaningful-validation:end -->
BLOCK
if [ -s "$repository_clean" ] && [ -n "$(tail -c 1 "$repository_clean")" ]; then
  printf '\n'
fi
printf '%s\n%s\n' "$repository_heading" "$repository_line"

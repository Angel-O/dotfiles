{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "experimental": {
    "todo": true,
    "subagent_depth": 2,
    "background_compaction": true
  },
  "plugins": [
    "@slkiser/opencode-quota@{{ .pins.openCodePlugins.quota }}",
    "-opencode.provider.openai-context-caps",
    {
      "package": "@plannotator/opencode@{{ .pins.openCodePlugins.plannotator }}",
      "options": { "planningAgents": ["plan", "architect"] }
    },
    "opencode-handoff@{{ .pins.openCodePlugins.handoff }}",
    {{ if .modules.warp }}"@warp-dot-dev/opencode-warp@{{ .pins.openCodePlugins.warp }}",{{ end }}
    "../../.local/share/opencode/orchestration-tracking/src"
  ],
  {{ if and (dig "modules" "serena" false .) .modules.opencode }}
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": ["{env:HOME}/.local/bin/serena", "start-mcp-server", "--transport", "stdio", "--agent-interface", "tools", "--enable-web-dashboard", "false"],
        "codemode": false
      }
    }
  },
  "permissions": [
    { "action": "serena_*", "resource": "*", "effect": "deny" }
  ],
  {{ end }}
  "agent": {
    "title": {
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "none"
      }
    }
  },
  "agents": {
    "orchestrator": {
      "color": "#C099FF",
      "model": "{env:OPENCODE_AGENT_MODEL_ORCHESTRATOR}"
    },
    "build": {
      "color": "#82AAFF",
      "model": "{env:OPENCODE_AGENT_MODEL_BUILD}"
    },
    "plan": {
      "color": "#FF966C",
      "model": "{env:OPENCODE_AGENT_MODEL_PLAN}"
    },
    "architect": {
      "color": "#C3E88D",
      "model": "{env:OPENCODE_AGENT_MODEL_ARCHITECT}"
    },
    "worker": {
      "color": "#FF757F",
      "model": "{env:OPENCODE_AGENT_MODEL_WORKER}"{{ if and (dig "modules" "serena" false .) .modules.opencode }},
      "permissions": [
        { "action": "serena_activate_project", "resource": "*", "effect": "allow" },
        { "action": "serena_initial_instructions", "resource": "*", "effect": "allow" },
        { "action": "serena_get_symbols_overview", "resource": "*", "effect": "allow" },
        { "action": "serena_find_symbol", "resource": "*", "effect": "allow" },
        { "action": "serena_find_referencing_symbols", "resource": "*", "effect": "allow" },
        { "action": "serena_replace_symbol_body", "resource": "*", "effect": "allow" },
        { "action": "serena_insert_before_symbol", "resource": "*", "effect": "allow" },
        { "action": "serena_insert_after_symbol", "resource": "*", "effect": "allow" },
        { "action": "serena_replace_content", "resource": "*", "effect": "allow" }
      ]{{ end }}
    },
    "investigator": {
      "model": "{env:OPENCODE_AGENT_MODEL_INVESTIGATOR}"
    },
    "integration": {
      "model": "{env:OPENCODE_AGENT_MODEL_INTEGRATION}"
    },
    "reviewer": {
      "model": "{env:OPENCODE_AGENT_MODEL_REVIEWER}"
    },
    "test-scope-reviewer": {
      "model": "{env:OPENCODE_AGENT_MODEL_TEST_SCOPE_REVIEWER}"
    },
    "scope-complexity-reviewer": {
      "model": "{env:OPENCODE_AGENT_MODEL_REVIEWER}"
    }
  }{{ if eq .role "personal" }},
  "disabled_providers": ["opencode"],
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      }
    }
  }{{ end }}
}

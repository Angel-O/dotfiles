{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "plugins": [
    "@slkiser/opencode-quota@{{ .pins.openCodePlugins.quota }}",
    "../../.local/share/opencode/opencode-todo/src",
    "@plannotator/opencode@{{ .pins.openCodePlugins.plannotator }}",
    "../../.local/share/opencode/orchestration-tracking/src"
  ],
  "agent": {
    "title": {
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "none"
      }
    }
  },
  "agents": {
    "orchestrator": {
      "color": "#C099FF",
      "model": "{env:OPENCODE_AGENT_MODEL_ORCHESTRATOR}"
    },
    "build": {
      "color": "#82AAFF"
    },
    "plan": {
      "color": "#FF966C"
    },
    "architect": {
      "color": "#C3E88D",
      "model": "{env:OPENCODE_AGENT_MODEL_ARCHITECT}"
    },
    "worker": {
      "color": "#FF757F",
      "model": "{env:OPENCODE_AGENT_MODEL_WORKER}"
    },
    "investigator": {
      "model": "{env:OPENCODE_AGENT_MODEL_INVESTIGATOR}"
    },
    "integration": {
      "model": "{env:OPENCODE_AGENT_MODEL_INTEGRATION}"
    },
    "reviewer": {
      "model": "{env:OPENCODE_AGENT_MODEL_REVIEWER}"
    },
    "planner": {
      "model": "{env:OPENCODE_AGENT_MODEL_PLANNER}"
    }
  }{{ if eq .role "personal" }},
  "disabled_providers": ["opencode"],
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false
      }
    }
  }{{ end }}
}

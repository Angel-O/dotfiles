{{- $role := promptChoiceOnce . "role" "Machine role" (list "personal" "work") "personal" -}}
{{- $ghostty := promptBoolOnce . "modules.ghostty" "Enable the Ghostty module" false -}}
{{- $herdr := promptBoolOnce . "modules.herdr" "Enable the Herdr module" false -}}
{{- $opencode := promptBoolOnce . "modules.opencode" "Enable the OpenCode module" false -}}
{{- $starship := promptBoolOnce . "modules.starship" "Enable the Starship module" false -}}
{{- $shell := promptBoolOnce . "modules.shell" "Enable the Zsh shell module" false -}}
{{- $git := promptBoolOnce . "modules.git" "Enable the Git module" false -}}
{{- $nodeDevelopment := false -}}
{{- $jvmDevelopment := false -}}
{{- $agentResume := false -}}
{{- $labels := false -}}
{{- $recentNavigator := false -}}
{{- $spaceUsage := false -}}
{{- $bar := false -}}
{{- $zoxide := false -}}
{{- $elio := false -}}
{{- $reviewr := false -}}
{{- if $shell -}}
{{- $nodeDevelopment = promptBoolOnce . "features.nodeDevelopment" "Enable optional Node development setup" false -}}
{{- $jvmDevelopment = promptBoolOnce . "features.jvmDevelopment" "Enable optional JVM development setup" false -}}
{{- end -}}
{{- if $herdr -}}
{{- $agentResume = promptBoolOnce . "herdrPlugins.agentResume" "Enable the Herdr Agent Resume plugin" true -}}
{{- $labels = promptBoolOnce . "herdrPlugins.labels" "Enable the Herdr Labels plugin" true -}}
{{- $recentNavigator = promptBoolOnce . "herdrPlugins.recentNavigator" "Enable the Herdr Recent Navigator plugin" true -}}
{{- $spaceUsage = promptBoolOnce . "herdrPlugins.spaceUsage" "Enable the Herdr Space Usage plugin" true -}}
{{- $bar = promptBoolOnce . "herdrPlugins.bar" "Enable the Herdr Bar plugin" true -}}
{{- $zoxide = promptBoolOnce . "herdrPlugins.zoxide" "Enable the Herdr Zoxide plugin" true -}}
{{- $elio = promptBoolOnce . "herdrPlugins.elio" "Enable the Herdr Elio plugin" false -}}
{{- $reviewr = promptBoolOnce . "herdrPlugins.reviewr" "Enable the Herdr Reviewr plugin" true -}}
{{- end -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
role = {{ $role | quote }}

[data.modules]
ghostty = {{ $ghostty }}
herdr = {{ $herdr }}
opencode = {{ $opencode }}
starship = {{ $starship }}
shell = {{ $shell }}
git = {{ $git }}

[data.features]
nodeDevelopment = {{ $nodeDevelopment }}
jvmDevelopment = {{ $jvmDevelopment }}

[data.herdrPlugins]
agentResume = {{ $agentResume }}
labels = {{ $labels }}
recentNavigator = {{ $recentNavigator }}
spaceUsage = {{ $spaceUsage }}
bar = {{ $bar }}
zoxide = {{ $zoxide }}
elio = {{ $elio }}
reviewr = {{ $reviewr }}

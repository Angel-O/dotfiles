{{- $opencodeBeads := dig "integrations" "opencodeBeads" false . -}}
{{ if .modules.opencode }}
[".config/opencode/skills/grilling/SKILL.md"]
type = "file"
url = "https://raw.githubusercontent.com/mattpocock/skills/{{ .pins.grillingSkill }}/skills/productivity/grilling/SKILL.md"
[".config/opencode/skills/ponytail/SKILL.md"]
type = "file"
url = "https://raw.githubusercontent.com/dietrichgebert/ponytail/{{ .pins.ponytailSkill }}/skills/ponytail/SKILL.md"
{{ end }}
{{ if and .modules.beads $opencodeBeads }}
["beadsViewerSkills"]
type = "archive"
url = "https://github.com/{{ .pins.beadsViewer.source }}/archive/{{ .pins.beadsViewer.ref }}.tar.gz"
stripComponents = 2
include = ["*/skills/**"]
targetPath = ".config/opencode/skills"
{{ end }}

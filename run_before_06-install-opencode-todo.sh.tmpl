#!/bin/sh
set -eu

{{- if not .modules.opencode }}
exit 0
{{- else }}
ensure_checkout() {
  url=$1
  path=$2
  wanted_ref=$3
  created=0

  if [ ! -e "$path" ]; then
    mkdir -p "$(dirname "$path")"
    git clone --filter=blob:none --no-checkout "$url" "$path"
    created=1
  elif [ ! -d "$path/.git" ]; then
    printf '%s exists but is not a Git checkout; refusing to overwrite it.\n' "$path" >&2
    exit 1
  fi

  current_ref=$(git -C "$path" rev-parse HEAD 2>/dev/null || true)
  if [ "$created" -eq 0 ] && [ -n "$(git -C "$path" status --porcelain --untracked-files=no)" ]; then
    printf '%s has local changes; refusing to move it to pinned commit %s.\n' "$path" "$wanted_ref" >&2
    exit 1
  fi
  if [ "$current_ref" = "$wanted_ref" ] && [ "$created" -eq 0 ]; then
    git -C "$path" checkout --detach "$wanted_ref"
    return
  fi

  git -C "$path" fetch --depth 1 origin "$wanted_ref"
  resolved_ref=$(git -C "$path" rev-parse FETCH_HEAD)
  if [ "$resolved_ref" != "$wanted_ref" ]; then
    printf 'opencode-todo ref mismatch: expected %s, fetched %s.\n' \
      "$wanted_ref" "$resolved_ref" >&2
    exit 1
  fi
  git -C "$path" checkout --detach "$resolved_ref"
}

ensure_checkout \
  {{ .pins.openCodePlugins.todo.source | quote }} \
  "$HOME/.local/share/opencode/opencode-todo" \
  {{ .pins.openCodePlugins.todo.ref | quote }}
{{- end }}
